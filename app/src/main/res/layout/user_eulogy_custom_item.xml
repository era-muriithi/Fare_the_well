<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     REVAMPED: EULOGY MANAGEMENT LIST ITEM (RecyclerView row)
     Aesthetic: Warm Luxury Memorial — navy + ivory + gold
     All original IDs preserved.
     ============================================================ -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="7dp"
    android:layout_marginBottom="7dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="4dp">

    <RelativeLayout
        android:id="@+id/list_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <!-- ── LEFT GOLD ACCENT STRIP ── -->
        <View
            android:id="@+id/accentStrip"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:minHeight="110dp"
            android:background="@drawable/item_accent_strip_bg"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true" />

        <!-- ── CIRCLE AVATAR ── -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/accentStrip"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:scaleType="centerCrop"
            android:src="@drawable/rame"
            app:civ_border_width="2dp"
            app:civ_border_color="#D4AF6A" />

        <!-- ── CONTENT BLOCK ── -->
        <LinearLayout
            android:id="@+id/contentBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/img"
            android:layout_alignParentTop="true"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <!-- Names row -->
            <LinearLayout
                android:id="@+id/namesLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/Fname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John"
                    android:textColor="#0C1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/Sname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Mark"
                    android:textColor="#0C1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/Lname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Woods"
                    android:textColor="#0C1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Short gold rule beneath name -->
            <View
                android:layout_width="38dp"
                android:layout_height="1.5dp"
                android:background="#D4AF6A"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="6dp" />

            <!-- Dates row -->
            <LinearLayout
                android:id="@+id/datesLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/calendar"
                    android:tint="#D4AF6A"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="Dates" />

                <TextView
                    android:id="@+id/born_dates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/12/2020"
                    android:textColor="#6B5E42"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:textColor="#D4AF6A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/death_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/12/2020"
                    android:textColor="#6B5E42"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Status + Delete row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp">

                <!-- Status badge -->
                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unconfirmed"
                    android:textColor="#B45309"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/status_badge_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginEnd="10dp" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Delete button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/delete_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_delete_bg"
                    android:drawableEnd="@drawable/delete_24"
                    android:drawablePadding="5dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Delete"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>