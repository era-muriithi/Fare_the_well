<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     REVAMPED: BANNER HERO + FULL NAME + RECYCLER
     Aesthetic: Warm Luxury Memorial — navy + ivory + gold
     All original IDs preserved.
     ============================================================ -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E8">

    <!-- ── HERO FRAME (image + overlays + name) ── -->
    <FrameLayout
        android:id="@+id/heroFrame"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_alignParentTop="true">

        <!-- Banner image -->
        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/iris"
            android:contentDescription="Memorial banner" />

        <!-- Bottom-up dark scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_gradient_overlay" />

        <!-- Name block — pinned to bottom of hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <!-- Gold overline label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FUNERAL PROGRAM"
                android:textColor="#D4AF6A"
                android:textSize="9sp"
                android:letterSpacing="0.18"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="5dp" />

            <!-- Full name -->
            <TextView
                android:id="@+id/fullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.15" />

            <!-- Gold decorative rule beneath name -->
            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:background="#D4AF6A"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </FrameLayout>

    <!-- Gold accent bar below hero -->
    <View
        android:id="@+id/goldRule"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#D4AF6A"
        android:layout_below="@+id/heroFrame" />

    <!-- ── RECYCLER VIEW ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPrograms"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/goldRule"
        android:padding="14dp"
        android:clipToPadding="false" />

</RelativeLayout>