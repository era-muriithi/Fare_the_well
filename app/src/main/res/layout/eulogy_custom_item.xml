<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     REVAMPED: DECEASED PERSON LIST ITEM (RecyclerView row)
     Aesthetic: Warm Luxury Memorial — navy + ivory + gold
     All original IDs preserved.
     ============================================================ -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="7dp"
    android:layout_marginBottom="7dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="4dp">

    <RelativeLayout
        android:id="@+id/list_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <!-- ── LEFT NAVY ACCENT STRIP ── -->
        <View
            android:id="@+id/accentStrip"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@drawable/item_accent_strip_bg"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:minHeight="80dp" />

        <!-- ── CIRCLE AVATAR ── -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/accentStrip"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:scaleType="centerCrop"
            android:src="@drawable/rame"
            app:civ_border_width="2dp"
            app:civ_border_color="#D4AF6A" />

        <!-- ── CONTENT COLUMN ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/img"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="52dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Names row -->
            <LinearLayout
                android:id="@+id/namesLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/Fname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John"
                    android:textColor="#0C1A2E"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinssemibold"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/Sname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Mark"
                    android:textColor="#0C1A2E"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinssemibold"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/Lname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Woods"
                    android:textColor="#0C1A2E"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppinssemibold"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Gold thin rule under name -->
            <View
                android:layout_width="40dp"
                android:layout_height="1.5dp"
                android:background="#D4AF6A"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Dates row -->
            <LinearLayout
                android:id="@+id/datesLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Born icon -->
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/calendar"
                    android:tint="#D4AF6A"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Born" />

                <TextView
                    android:id="@+id/born_dates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/12/2020"
                    android:textColor="#6B5E42"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinssemibold" />

                <!-- Separator dot -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:textColor="#D4AF6A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/death_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/12/2020"
                    android:textColor="#6B5E42"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinssemibold" />

            </LinearLayout>
        </LinearLayout>

        <!-- ── CHEVRON ARROW (right side) ── -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:src="@drawable/arrow_circle_right_24"
            android:contentDescription="View details"
            android:alpha="0.8"
            app:tint="#D4AF6A" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>