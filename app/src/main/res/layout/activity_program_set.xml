<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     REVAMPED: CREATE FUNERAL PROGRAM
     Aesthetic: Warm Luxury Memorial — navy + ivory + gold
     All original IDs preserved.
     ============================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0E8">

    <!-- ── TOP HEADER BAR ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0C1A2E"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Gold overline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERVICE ORDER"
            android:textColor="#D4AF6A"
            android:textSize="10sp"
            android:letterSpacing="0.18"
            android:fontFamily="sans-serif-medium"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp" />

        <!-- Screen title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Funeral Program"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <!-- Gold decorative rule -->
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#D4AF6A"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <!-- ── FORM CARD ── -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="18dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:background="#D4AF6A"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add Program Item"
                    android:textColor="#0C1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Start Time field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="START TIME"
                android:textColor="#D4AF6A"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#D4AF6A"
                app:hintTextColor="#8A7A5A"
                app:endIconDrawable="@drawable/calendar"
                app:endIconTint="#D4AF6A"
                app:endIconMode="custom"
                app:boxStrokeWidth="1.5dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/StarttimeEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Start Time"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="#1A1A2E"
                    android:textSize="14sp"
                    android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Program / Action field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROGRAM ITEM"
                android:textColor="#D4AF6A"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#D4AF6A"
                app:hintTextColor="#8A7A5A"
                app:counterEnabled="true"
                app:counterMaxLength="200"
                app:boxStrokeWidth="1.5dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/actionEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="90dp"
                    android:gravity="top|start"
                    android:hint="e.g. Opening Prayer, Eulogy, Hymn…"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textColor="#1A1A2E"
                    android:textSize="14sp"
                    android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Add Program Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/addButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_add_program_bg"
                android:drawableEnd="@drawable/baseline_add_24"
                android:drawablePadding="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Add to Program"
                android:textColor="#0C1A2E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ── PROGRAM LIST LABEL ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="#D4AF6A"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Program Items"
            android:textColor="#0C1A2E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Item count badge -->
        <TextView
            android:id="@+id/itemCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_navy_bg"
            android:text="0 items"
            android:textColor="#D4AF6A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- ── RECYCLER VIEW ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- ── BOTTOM AREA ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp">

        <!-- Thin gold rule at top of bottom bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8D9A0"
            android:layout_marginBottom="14dp" />

        <!-- Preview / Proceed button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/previewButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/btn_proceed_bg"
            android:drawableEnd="@drawable/arrow_circle_right_24"
            android:drawablePadding="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="PROCEED TO PREVIEW"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </LinearLayout>

</LinearLayout>