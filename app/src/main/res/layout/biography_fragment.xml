<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     REVAMPED: DECEASED DETAIL / PROFILE SCREEN
     Aesthetic: Warm Luxury Memorial — navy + ivory + gold
     All original IDs preserved. Tributes section added.
     ============================================================ -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════
             HERO IMAGE + OVERLAY
             ══════════════════════════════════════ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp">

            <ImageView
                android:id="@+id/detailMainImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Photo of the deceased" />

            <!-- Bottom-up dark scrim -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hero_gradient_overlay" />

            <!-- Overlay content pinned to bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Gold overline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IN LOVING MEMORY"
                    android:textColor="#D4AF6A"
                    android:textSize="10sp"
                    android:letterSpacing="0.18"
                    android:fontFamily="sans-serif-medium"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp" />

                <!-- Full name row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/deceased_Fname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mark"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/deceased_Sname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Were"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/deceased_Lname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Miha"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Burial location row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/location_on"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="Burial location"
                        app:tint="#D4AF6A" />

                    <TextView
                        android:id="@+id/burial_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#D4AF6A"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Gold accent rule -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#D4AF6A" />

        <!-- ══════════════════════════════════════
             DATES BANNER
             ══════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/datesLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0C1A2E"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BORN"
                    android:textColor="#8A9AB5"
                    android:textSize="9sp"
                    android:letterSpacing="0.14"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/deceased_born_dates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Gold em-dash -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8211;"
                android:textColor="#D4AF6A"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="serif" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSED"
                    android:textColor="#8A9AB5"
                    android:textSize="9sp"
                    android:letterSpacing="0.14"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/decease_death_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════
             CARD: EULOGY
             ══════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Card header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:background="#D4AF6A"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/earlylifeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Eulogy"
                        android:textColor="#0C1A2E"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Decorative open-quote -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#8220;"
                    android:textColor="#E8D9A0"
                    android:textSize="52sp"
                    android:fontFamily="serif"
                    android:lineSpacingMultiplier="0.5"
                    android:layout_marginBottom="-10dp" />

                <TextView
                    android:id="@+id/life_biography"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:textColor="#2C2C2C"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.7"
                    android:fontFamily="serif" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════
             CARD: LIFE IN PICTURES / GALLERY
             ══════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Card header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:background="#D4AF6A"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/pictures"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Life in Pictures"
                        android:textColor="#0C1A2E"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Gallery grid -->
                <com.blackgoose.fare_the_well.ExpandedGridviewAdapter
                    android:id="@+id/galleryGridView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:numColumns="3"
                    android:verticalSpacing="6dp"
                    android:horizontalSpacing="6dp"
                    android:stretchMode="columnWidth"
                    android:padding="2dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════
             SECTION DIVIDER: TRIBUTES
             ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D4AF6A"
                android:alpha="0.45" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦  TRIBUTES  ✦"
                android:textColor="#D4AF6A"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D4AF6A"
                android:alpha="0.45" />

        </LinearLayout>

        <!-- ══════════════════════════════════════
             CARD: LEAVE A TRIBUTE (INPUT)
             ══════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Card header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:background="#D4AF6A"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Leave a Tribute"
                        android:textColor="#0C1A2E"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tribute message input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR TRIBUTE"
                    android:textColor="#8A9AB5"
                    android:textSize="9sp"
                    android:letterSpacing="0.14"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/tributeMessageInput"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/tribute_input_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:hint="Share a memory, prayer, or kind word…"
                    android:textSize="14sp"
                    android:textColor="#0C1A2E"
                    android:textColorHint="#C5BFB2"
                    android:fontFamily="serif"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top|start"
                    android:imeOptions="actionDone"
                    android:layout_marginBottom="18dp" />

                <!-- Submit button -->
                <Button
                    android:id="@+id/submitTributeBtn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Post Tribute"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:letterSpacing="0.06"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/btn_proceed_bg"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════
             CARD: TRIBUTES DISPLAY LIST
             ══════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="40dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Card header row with tribute count badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:background="#D4AF6A"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tributes"
                        android:textColor="#0C1A2E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Tribute count badge -->
                    <TextView
                        android:id="@+id/tributeCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_navy_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="0"
                        android:textColor="#D4AF6A"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <!-- Empty state (shown when no tributes yet) -->
                <LinearLayout
                    android:id="@+id/tributeEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#9825;"
                        android:textColor="#D4AF6A"
                        android:textSize="32sp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Be the first to leave a tribute"
                        android:textColor="#A09890"
                        android:textSize="13sp"
                        android:fontFamily="serif"
                        android:textStyle="italic"
                        android:layout_gravity="center_horizontal" />

                </LinearLayout>

                <!-- Tribute items container — populated programmatically -->
                <LinearLayout
                    android:id="@+id/tributeListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>